<?xml version="1.0" encoding="utf-8"?>
<!--
  Desde Android 9 (API 28) el tráfico HTTP sin cifrar está bloqueado por
  defecto. El panel en producción va por HTTPS, pero el de desarrollo corre en
  `http://<ip-de-la-maquina>:3000`, y sin esta excepción la app no puede
  conectarse a nada: falla con un "CLEARTEXT communication not permitted" que
  parece un problema de red.

  `base-config` queda en **false** a propósito: así un APK apuntado al panel de
  producción sigue exigiendo HTTPS. Lo que se permite es solo la lista de abajo.

  Si la IP de la máquina cambia (la da el router por DHCP), hay que agregarla
  acá o la app deja de conectarse. Es el precio de no permitir HTTP a cualquier
  destino.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- La máquina de desarrollo en la red local (Wi-Fi). -->
        <domain includeSubdomains="false">192.168.18.15</domain>
        <!-- Cómo el emulador de Android ve el localhost de su anfitrión. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
