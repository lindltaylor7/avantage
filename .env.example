# Servidor
PORT=3000
# URL base pública donde corre el FRONTEND (Vite), sin slash final. Se usa
# para redirigir de vuelta al navegador tras el consentimiento de Google.
APP_BASE_URL=http://localhost:5173

# Google Calendar (conexión por asesor, para crear reuniones con Google Meet)
# Crear en console.cloud.google.com: habilitar "Google Calendar API",
# configurar la pantalla de consentimiento OAuth con el scope
# https://www.googleapis.com/auth/calendar.events, y generar credenciales
# de "ID de cliente de OAuth" tipo "Aplicación web".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTO con un "URI de redirección autorizado" en Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# ID (tabla users) del asesor cuyo Google Calendar usa el bot de WhatsApp (Avan)
# para agendar llamadas automáticamente al terminar de calificar un lead. Debe
# tener su Google Calendar conectado y su horario configurado en Mi Disponibilidad.
GOOGLE_BOOKING_ADVISOR_USER_ID=1

# Ollama Cloud / API Configuration
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
# Nota: /api/embed no está autorizado por el plan de Ollama Cloud (siempre 401),
# por lo que el motor local de embeddings se usa automáticamente como fallback.
OLLAMA_EMBED_MODEL=nomic-embed-text
# El chat requiere un modelo alojado en la nube (ver: https://ollama.com/search?c=cloud)
OLLAMA_CHAT_MODEL=gpt-oss:20b

# Base de datos MySQL (leads del funnel de ventas) - ver db/README.md
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=minirag_leads

# Autenticación (login interno: Panel de Leads / Proyectos / Roles y Permisos)
# Genera un valor propio, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_random_secret
JWT_EXPIRES_IN=8h

# Configuración de Correo SMTP (Opcional - Si no se configura, se usará Ethereal Mail automático)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM="Evaluador de Tesis Perú <no-reply@tesisperu.edu.pe>"

# Meta (Facebook/Instagram) Lead Ads - Webhook de leads
# Endpoint: GET/POST /api/webhooks/meta
# META_VERIFY_TOKEN: texto que tú inventas; debe coincidir con el que pongas
#   en "Identificador de verificación" al configurar el webhook en Meta.
# META_APP_SECRET: "Configuración de la aplicación" > Básica, en developers.facebook.com.
#   Se usa para validar la firma X-Hub-Signature-256 de cada evento.
# META_PAGE_ACCESS_TOKEN: token de acceso de la Página (no el de la app), obtenido
#   vía "Inicio de sesión con Facebook para empresas" o el Explorador de la API Graph,
#   con permisos leads_retrieval, pages_show_list y pages_manage_metadata.
#   Para que el panel de Instagram (perfil, publicaciones, comentarios) también
#   funcione con datos reales, este mismo token necesita además los permisos
#   instagram_basic, instagram_manage_comments, pages_read_engagement y
#   business_management, y la Página debe tener una cuenta de Instagram
#   Profesional vinculada (Meta Business Suite > Configuración > Cuentas vinculadas).
META_VERIFY_TOKEN=un_token_secreto_que_tu_inventas
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Cada cuánto se sondea el conteo de seguidores de la página (ms). Por defecto 1 hora.
META_FOLLOWER_POLL_INTERVAL_MS=3600000

# Instagram Graph API / Messaging - Webhook de Instagram
# Endpoint: GET/POST /api/webhooks/instagram
# META_INSTAGRAM_VERIFY_TOKEN: texto que tú inventas; debe coincidir con el que pongas
#   en "Identificador de verificación" al configurar el webhook de Instagram en Meta Developers.
META_INSTAGRAM_VERIFY_TOKEN=avantage_instagram_webhook_9d4e2a1b
# META_INSTAGRAM_ACCOUNT_ID (opcional): ID numérico de la cuenta de Instagram Business
#   (Meta Business Suite > Configuración > Cuentas > Instagram, o GET /me/accounts con
#   el campo instagram_business_account). Solo hace falta si el bot no logra resolverlo
#   automáticamente a partir de META_PAGE_ACCESS_TOKEN.
META_INSTAGRAM_ACCOUNT_ID=
# META_INSTAGRAM_APP_SECRET (opcional): solo si la suscripción de webhooks de
#   Instagram vive en una app de Meta distinta a la que usa META_APP_SECRET
#   arriba (cada app tiene su propio App Secret). Si no se define, se usa
#   META_APP_SECRET para validar la firma X-Hub-Signature-256 de este webhook.
META_INSTAGRAM_APP_SECRET=

# WhatsApp Business Platform - Webhook de mensajes

# Endpoint: GET/POST /api/webhooks/whatsapp (usa el mismo META_APP_SECRET de arriba
# para validar la firma; este producto tiene su propio campo de verify token en Meta).
META_WHATSAPP_VERIFY_TOKEN=otro_token_secreto_que_tu_inventas
# Necesarios para RESPONDER mensajes (POST .../messages de la Graph API):
# META_WHATSAPP_PHONE_NUMBER_ID: en WhatsApp > Configuración de la API, "ID del número de teléfono"
#   del número conectado (no el número en sí).
# META_WHATSAPP_ACCESS_TOKEN: token con permiso whatsapp_business_messaging. Si no se define,
#   se reutiliza META_PAGE_ACCESS_TOKEN.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
# Rango de espera (ms) antes de cada mensaje automático de Avan por WhatsApp,
# para simular tiempo de "escribiendo..." y evitar ráfagas que WhatsApp pueda
# marcar como comportamiento de spam/bot.
WHATSAPP_BOT_DELAY_MIN_MS=1500
WHATSAPP_BOT_DELAY_MAX_MS=3500
# Tiempo de silencio (ms) que se espera tras el/los primer(os) mensaje(s) de un
# contacto nuevo antes de juntarlos en un solo texto y generar el saludo de
# bienvenida con el LLM de Ollama Cloud (ver OllamaService.generateWelcomeMessage).
# Espera de silencio antes de procesar un turno, para juntar las burbujas que
# el contacto manda seguidas. Más alta al inicio de la conversación (es cuando
# más entrecortado se escribe) y más corta en el agendamiento y después de
# agendar, donde la respuesta suele venir en una sola burbuja.
WHATSAPP_BOT_FIRST_MESSAGE_DEBOUNCE_MS=7000
WHATSAPP_BOT_SCHEDULING_DEBOUNCE_MS=5000
WHATSAPP_BOT_POST_BOOKING_DEBOUNCE_MS=5000
# Prórroga extra (una sola vez) cuando lo único recibido es un saludo suelto
# ("hola", "buenas tardes"): casi siempre viene seguido del mensaje real.
WHATSAPP_BOT_GREETING_EXTRA_WAIT_MS=8000
