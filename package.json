{
  "name": "minirag-tesis-viabilidad",
  "version": "1.0.0",
  "description": "Evaluador de Viabilidad de Temas de Tesis en Perú con Node.js, Vue 3, Ollama Cloud y Email",
  "main": "boot.cjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node --watch backend/server.js",
    "start": "node boot.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "migrate": "knex migrate:latest --knexfile backend/db/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile backend/db/knexfile.js",
    "migrate:status": "knex migrate:status --knexfile backend/db/knexfile.js",
    "migrate:make": "knex migrate:make --knexfile backend/db/knexfile.js -x js --migrations-directory backend/db/migrations",
    "seed": "knex seed:run --knexfile backend/db/knexfile.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^6.9.13",
    "ollama": "^0.5.1",
    "vue": "^3.4.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.2.11"
  }
}
